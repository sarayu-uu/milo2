# PostHog (product research analytics). Leave empty to log events to the console in development.
NEXT_PUBLIC_POSTHOG_KEY=

# Optional: where parent feedback-survey responses are forwarded (server-side only).
# If empty, responses go to PostHog as an unlinked `feedback_response` event, or are logged.
FEEDBACK_WEBHOOK_URL=

# ElevenLabs (voice pipeline: npm run voice:scan / voice:generate). Server/scripts only, never NEXT_PUBLIC.
ELEVENLABS_API_KEY=

# Supabase: where parent feedback (survey + after-activity) is stored. Server only, never NEXT_PUBLIC.
# Project Settings -> API: the project URL and a secret key (sb_secret_...).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Admin page (/admin): just for the Milomi team. At least 8 characters.
ADMIN_PASSWORD=

# PostHog read access for the admin page (Settings -> Personal API keys, scope: Query Read; and your project id).
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# Optional: https://eu.posthog.com (default) or https://us.posthog.com
# POSTHOG_API_HOST=
# Optional: time zone for dates on the admin page (default Asia/Kolkata)
# ADMIN_TIMEZONE=

# Analytics is not sent when the app runs on localhost / a local IP (keeps testing out of the numbers).
# Set to 1 to send anyway, e.g. to check events arrive in PostHog.
# NEXT_PUBLIC_ANALYTICS_ON_LOCALHOST=1
